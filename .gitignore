# Rust build artifacts
/target/

# Backtraces
rustc-ice-*.txt

# QA runner artifacts
/logs/
/outputs/
/reports/
/.qa-tmp/

# Editor / OS noise
*.swp
.DS_Store

# Agent session / runtime artifacts — never commit these onto audit branches.
.claude/
.claude/runtime/
.claude/**/runtime/

# Secrets — never commit credentials or key material.
.env
.env.*
*.pem
*.key

# gadugi-agentic-test runtime artifacts (qa/ parity harness runs, in the repo root
# or under qa/ depending on the working directory).
/logs/
/outputs/
/reports/
/screenshots/
/qa/outputs/
/qa/reports/
/qa/logs/
/qa/temp/
/qa/screenshots/

# CVE corpus fetch scratch directory (default --dest for `fetch-cve-corpus`)
/.scratch/
